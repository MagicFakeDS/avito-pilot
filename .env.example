# Скопируйте в .env и заполните. Файл .env не попадает в git.
ANTHROPIC_API_KEY=
# ID рабочего пространства из Anthropic Console (Settings → Workspaces), если ключ к нему не привязан
ANTHROPIC_WORKSPACE_ID=
BOT_TOKEN=
# id пользователей Telegram через запятую, кому можно пользоваться ботом
BOT_ALLOWED_USERS=
# Лимит запросов на пользователя (0 или пусто = без лимита)
BOT_REQUEST_LIMIT=
# Админы (безлимит), id через запятую
BOT_ADMINS=
# PUBLIC_URL=https://example.com

# Загрузка по ссылке (нужен playwright: npm i playwright). Сначала прогрейте
# профиль: npm run avito:login
# AVITO_PAGES=1
# Папка профиля (по умолчанию server/browser-profile)
# AVITO_BROWSER_PROFILE=
# Браузер: chrome (по умолчанию пробуется системный Chrome), msedge или пусто (встроенный)
# AVITO_BROWSER_CHANNEL=
# AVITO_HEADLESS=1
