# Скопируйте в .env и заполните. Файл .env не попадает в git.
ANTHROPIC_API_KEY=
# ID рабочего пространства из Anthropic Console (Settings → Workspaces), если ключ к нему не привязан
ANTHROPIC_WORKSPACE_ID=

# === Какую нейросеть использовать ===
# claude (по умолчанию) или openai — OpenAI-совместимый провайдер: ChatGPT, а также
# OpenRouter, DeepSeek, Groq, локальные и т.п. (через OPENAI_BASE_URL).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# Базовый URL (по умолчанию OpenAI). OpenRouter: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini

BOT_TOKEN=
# id пользователей Telegram через запятую, кому можно пользоваться ботом
BOT_ALLOWED_USERS=
# Лимит запросов на пользователя (0 или пусто = без лимита)
BOT_REQUEST_LIMIT=
# Админы (безлимит), id через запятую
BOT_ADMINS=
# «Обучение»: свои правила и стиль продавца — подмешиваются во ВСЕ ответы бота
# (либо положите их в data/instructions.md). Свои скиллы — в data/skills.json.
# CUSTOM_INSTRUCTIONS=
# PUBLIC_URL=https://example.com

# Загрузка по ссылке (нужен playwright: npm i playwright). Сначала прогрейте
# профиль: npm run avito:login
# AVITO_PAGES=1
# Папка профиля (по умолчанию server/browser-profile)
# AVITO_BROWSER_PROFILE=
# Браузер: chrome (по умолчанию пробуется системный Chrome), msedge или пусто (встроенный)
# AVITO_BROWSER_CHANNEL=
# AVITO_HEADLESS=1
